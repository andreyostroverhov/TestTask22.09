@model HomeLibrary.Web.Models.Book
@{
    ViewData["Title"] = "Новая книга";
}

<h1 class="h3 mb-3">Новая книга</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <partial name="_BookFormFields" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_TocEditorScripts" model="Model" />
}